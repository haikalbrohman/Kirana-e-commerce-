# =====================================================================
# Shopia API (NestJS) — salin ke .env lalu isi. JANGAN commit file .env.
# =====================================================================
NODE_ENV=development
PORT=4000

# PostgreSQL (sama dengan yang dipakai web/Auth.js)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopia

# Alamat web (untuk CORS & tautan kembali dari Midtrans)
WEB_ORIGIN=http://localhost:3000
# Alamat publik API ini (dipakai untuk URL foto pada penyimpanan lokal)
PUBLIC_API_URL=http://localhost:4000

# Rahasia bersama dengan web untuk memverifikasi identitas pengguna (min. 32 karakter)
# Buat dengan: openssl rand -base64 48
API_JWT_SECRET=

# ---------------- Pembayaran ----------------
# "mock" = simulator lokal (DITOLAK di production), "midtrans" = Midtrans Snap
PAYMENT_PROVIDER=mock
# Dari dashboard Midtrans: Settings > Access Keys (pakai kunci SANDBOX dulu)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Batas waktu pembayaran (menit)
PAYMENT_EXPIRY_MINUTES=1440
# Biaya platform (%) yang ditampilkan di laporan penjual (0 = belum ada biaya)
PLATFORM_FEE_PERCENT=0

# ---------------- Penyimpanan foto ----------------
# "local" (folder UPLOAD_DIR, untuk pengembangan) atau "s3" (Cloudflare R2 / Supabase Storage / AWS S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publik bucket, mis. https://cdn.shopia.id
S3_PUBLIC_URL=

# ---------------- AI ----------------
# Tanpa kunci, Shopia memakai mesin aturan lokal (gratis, tanpa model bahasa)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Batas pemakaian untuk mengendalikan biaya
AI_MAX_REQUESTS_PER_USER_PER_DAY=100
AI_MAX_TOKENS_PER_DAY=2000000
