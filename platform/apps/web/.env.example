# =====================================================================
# Shopia Web (Next.js) — salin ke .env.local lalu isi nilainya.
# JANGAN commit file .env.local.
# =====================================================================

# Alamat publik web ini (wajib di production, mis. https://shopia.id)
AUTH_URL=http://localhost:3000
# Rahasia enkripsi sesi. Buat dengan: openssl rand -base64 32
AUTH_SECRET=
# Wajib di beberapa hosting (Vercel mengisinya otomatis)
AUTH_TRUST_HOST=true

# Database yang sama dengan API (dipakai Auth.js untuk akun & token login email)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopia

# Alamat API NestJS (diakses dari server Next.js, bukan dari browser)
API_URL=http://localhost:4000
# Harus SAMA PERSIS dengan API_JWT_SECRET di API (minimal 32 karakter)
API_JWT_SECRET=

# Login Google (opsional). Buat di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email login (magic link) via Resend (opsional di pengembangan:
# tanpa kunci, link login dicetak di terminal server).
AUTH_RESEND_KEY=
EMAIL_FROM="Shopia <no-reply@shopia.id>"

# Login demo tanpa email (HANYA untuk pengembangan lokal; diabaikan di production)
AUTH_DEMO_LOGIN=false

# Email pemilik yang otomatis jadi Admin saat masuk (pisahkan dengan koma)
ADMIN_EMAILS=
